{
  "manifest_version": 3,
  "name": "SFLarp",
  "version": "1.0.0",
  "description": "Chess helper in your browser's side panel: Stockfish's best lines, opening playstyles, Blitz/Bullet modes and every legal move explained.",
  "icons": { "16": "icons/icon-16.png", "32": "icons/icon-32.png", "48": "icons/icon-48.png", "128": "icons/icon-128.png" },
  "action": { "default_title": "Open SFLarp", "default_icon": { "16": "icons/icon-16.png", "32": "icons/icon-32.png" } },
  "side_panel": { "default_path": "sidepanel.html" },
  "sidebar_action": { "default_panel": "sidepanel.html", "default_title": "SFLarp", "default_icon": "icons/icon-32.png", "open_at_install": false },
  "background": { "service_worker": "background.js", "scripts": ["background.js"] },
  "permissions": ["sidePanel"],
  "content_security_policy": { "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'" },
  "browser_specific_settings": { "gecko": { "id": "sflarp@hxrply.github.io", "strict_min_version": "121.0" } }
}
